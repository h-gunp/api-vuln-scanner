APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/security_scanner
REDIS_URL=redis://redis:6379/0
ARTIFACT_ROOT=/app/artifacts
SCANNER_BASE_URL=http://scanner:8001
LLM_BASE_URL=http://llm:8002
INTEGRATION_TIMEOUT_SECONDS=10
USE_MOCK_INTEGRATIONS=false
TASK_MODE=background
ALLOW_PRIVATE_TARGETS=true
USER_A_USERNAME_ENV=USER_A_USERNAME
USER_A_PASSWORD_ENV=USER_A_PASSWORD
USER_B_USERNAME_ENV=USER_B_USERNAME
USER_B_PASSWORD_ENV=USER_B_PASSWORD
INTERNAL_AUTH_ENABLED=true
INTERNAL_SERVICE_TOKEN=local-development-token
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]

